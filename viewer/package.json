{
  "name": "@radsysx/viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build-ohif-dist.mjs",
    "dev": "npm run build && http-server ./dist -p 3001 -c-1",
    "test:fhir-bridge": "node ./scripts/test-fhir-bridge.mjs",
    "type-check": "tsc --noEmit -p ./tsconfig.json && tsc --noEmit -p ./tsconfig.live.json && tsc -p ./tsconfig.live-contracts.json",
    "audit:ohif": "node ./scripts/build-ohif-source.mjs --audit",
    "test:security": "node ./scripts/test-security-dependencies.mjs",
    "test:live": "node ./scripts/build-live.mjs --compile && node --test ./scripts/test-live.mjs ./scripts/test-evidence.mjs ./scripts/test-subscription.mjs"
  },
  "dependencies": {
    "@ohif/app": "3.13.4",
    "@radsysx/clinical-web": "file:../packages/clinical-web"
  },
  "devDependencies": {
    "dcmjs": "0.43.1",
    "http-server": "^14.1.1",
    "typescript": "^5.3.2",
    "webpack": "5.104.1"
  }
}
